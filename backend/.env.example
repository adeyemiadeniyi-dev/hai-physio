# IBM watsonx.ai Configuration
WATSONX_API_KEY=your_watsonx_api_key_here
WATSONX_PROJECT_ID=your_watsonx_project_id_here
WATSONX_URL=https://us-south.ml.cloud.ibm.com

# IBM Watson Text-to-Speech Configuration
IBM_TTS_API_KEY=your_watson_tts_api_key_here
IBM_TTS_URL=your_watson_tts_url_here

# Server Configuration
PORT=8000

# Instructions:
# 1. Copy this file to .env
# 2. Replace all placeholder values with your actual IBM Cloud credentials
# 3. Get watsonx.ai credentials from: https://cloud.ibm.com/watsonx
# 4. Get Watson TTS credentials from: https://cloud.ibm.com/catalog/services/text-to-speech
