# IBM watsonx.ai Configuration
WATSONX_API_KEY=your_watsonx_api_key_here
WATSONX_PROJECT_ID=your_watsonx_project_id_here
WATSONX_URL=https://us-south.ml.cloud.ibm.com

# Voice: using browser's window.speechSynthesis (works offline, no IBM TTS needed)
# IBM TTS may be added later during development if access is granted

# Database (PostgreSQL — create with: createdb hai_physio)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hai_physio

# Server
PORT=8000
